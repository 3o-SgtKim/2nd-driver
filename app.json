{
  "expo": {
    "name": "2nd Driver",
    "slug": "2nd-driver",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seconddriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161410",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vekaemi.x2nddriver",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161410",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O 2nd Driver usa suas fotos para a imagem do veículo.",
          "cameraPermission": "O 2nd Driver usa a câmera para fotografar o veículo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "githubOwner": "3o-SgtKim",
      "githubRepo": "2nd-driver"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
